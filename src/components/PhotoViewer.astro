---
/**
 * One full-screen viewer for every ZoomPhoto on the page. Arrows step through
 * the photos in page order; the caption is the photo's short caption, if any.
 */
---

<dialog class="viewer" aria-label="Photo viewer">
	<button type="button" class="viewer-close" aria-label="Close">×</button>
	<figure class="viewer-figure">
		<img class="viewer-img" src="" alt="" />
		<figcaption class="viewer-caption"></figcaption>
	</figure>
	<div class="viewer-controls">
		<button type="button" class="viewer-nav" aria-label="Previous photo">←</button>
		<span class="viewer-count" aria-live="polite"></span>
		<button type="button" class="viewer-nav" aria-label="Next photo">→</button>
	</div>
</dialog>

<script>
	const viewer = document.querySelector<HTMLDialogElement>(".viewer");

	if (viewer) {
		const buttons = [...document.querySelectorAll<HTMLButtonElement>(".zoom-photo")];
		const viewerImg = viewer.querySelector<HTMLImageElement>(".viewer-img")!;
		const caption = viewer.querySelector<HTMLElement>(".viewer-caption")!;
		const count = viewer.querySelector<HTMLElement>(".viewer-count")!;
		const [prev, next] = viewer.querySelectorAll<HTMLButtonElement>(".viewer-nav");
		let shown = 0;

		function show(index: number) {
			shown = (index + buttons.length) % buttons.length;
			const img = buttons[shown].querySelector("img")!;
			viewerImg.src = img.currentSrc || img.src;
			viewerImg.alt = img.alt;
			caption.textContent = buttons[shown].dataset.caption ?? "";
			count.textContent = `${shown + 1} / ${buttons.length}`;
		}

		buttons.forEach((button, i) =>
			button.addEventListener("click", () => {
				show(i);
				viewer.showModal();
			}),
		);

		prev.addEventListener("click", () => show(shown - 1));
		next.addEventListener("click", () => show(shown + 1));
		viewer.querySelector(".viewer-close")!.addEventListener("click", () => viewer.close());
		viewer.addEventListener("keydown", (e) => {
			if (e.key === "ArrowRight") show(shown + 1);
			else if (e.key === "ArrowLeft") show(shown - 1);
		});
		// Clicking the dark area around the photo closes the viewer.
		viewer.addEventListener("click", (e) => {
			if (e.target === viewer) viewer.close();
		});
		// Return focus to the last photo viewed, so keyboard users land where they left off.
		viewer.addEventListener("close", () => buttons[shown]?.focus());
	}
</script>

<style>
	.viewer {
		width: 100vw;
		max-width: 100vw;
		height: 100vh;
		max-height: 100vh;
		margin: 0;
		padding: var(--space-3);
		border: 0;
		background: rgb(28 27 25 / 0.94);
		color: var(--color-bg);
	}

	.viewer[open] {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
	}

	.viewer::backdrop {
		background: transparent;
	}

	.viewer-figure {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
		margin: 0;
		min-height: 0;
	}

	.viewer-img {
		max-width: min(90vw, 70rem);
		max-height: 78vh;
		width: auto;
		height: auto;
		border-radius: 4px;
	}

	.viewer-caption {
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		text-align: center;
		color: var(--color-bg);
	}

	.viewer-controls {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.viewer-count {
		min-width: 3.5rem;
		font-size: var(--text-sm);
		text-align: center;
		color: var(--color-line);
	}

	.viewer-nav,
	.viewer-close {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999px;
		border: 1px solid rgb(255 255 255 / 0.3);
		background: transparent;
		font-size: var(--text-body);
		color: var(--color-bg);
		cursor: pointer;
	}

	.viewer-close {
		position: absolute;
		top: var(--space-2);
		right: var(--space-2);
		font-size: var(--text-lg);
	}

	.viewer-nav:hover,
	.viewer-close:hover {
		border-color: var(--color-bg);
	}

	.viewer-nav:focus-visible,
	.viewer-close:focus-visible {
		outline: 2px solid var(--color-bg);
		outline-offset: 2px;
	}

	@media (max-width: 48rem) {
		.viewer {
			padding: var(--space-2);
		}
	}
</style>
