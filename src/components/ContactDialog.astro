---
// Contact pop-up. Messages are delivered by Web3Forms (a static site has no server of its own).
// If the key is ever removed, Send falls back to opening the visitor's mail app with the
// message filled in, so the form always works.
// Web3Forms keys are meant to be public: they only allow sending to the owner's inbox
const WEB3FORMS_KEY = "42d247fe-9054-4b1e-a1a6-be109218656e";
const email = "rualsanc@berkeley.edu";
---

<dialog class="contact-dialog" id="contact-dialog" aria-labelledby="contact-dialog-title">
	<div class="panel">
		<button type="button" class="close" data-close aria-label="Close">×</button>

		<div class="state state-form">
			<h2 id="contact-dialog-title">Say Hello!</h2>
			<p class="intro">Send me a note and it'll land straight in my inbox.</p>

			<form id="contact-form" data-key={WEB3FORMS_KEY} data-email={email} novalidate>
				<div class="row">
					<label for="contact-name">Your name</label>
					<input id="contact-name" name="name" type="text" autocomplete="name" required />
				</div>
				<div class="row">
					<label for="contact-email">Your email</label>
					<input id="contact-email" name="email" type="email" autocomplete="email" required />
				</div>
				<div class="row">
					<label for="contact-message">Your message</label>
					<textarea id="contact-message" name="message" rows="5" required></textarea>
				</div>
				<!-- Spam trap: people never see or fill this -->
				<input class="trap" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

				<p class="error" role="alert" hidden></p>
				<button type="submit" class="send">Send message</button>
			</form>

			<p class="direct">
				Prefer your own inbox? <a href={`mailto:${email}`}>{email}</a>
			</p>
		</div>

		<div class="state state-sent" hidden>
			<h2>Thank you!</h2>
			<p class="intro">Your message is on its way.</p>
			<button type="button" class="send" data-close>Close</button>
		</div>
	</div>
</dialog>

<script>
	const dialog = document.getElementById("contact-dialog") as HTMLDialogElement;
	const form = document.getElementById("contact-form") as HTMLFormElement;
	const formState = dialog.querySelector<HTMLElement>(".state-form")!;
	const sentState = dialog.querySelector<HTMLElement>(".state-sent")!;
	const error = form.querySelector<HTMLElement>(".error")!;
	const send = form.querySelector<HTMLButtonElement>(".send")!;
	const { key, email } = form.dataset;

	const open = () => {
		formState.hidden = false;
		sentState.hidden = true;
		error.hidden = true;
		dialog.showModal();
	};

	// Any element marked data-contact-open opens the pop-up; as a link it still works without JS
	document.querySelectorAll("[data-contact-open]").forEach((el) =>
		el.addEventListener("click", (e) => {
			e.preventDefault();
			open();
		}),
	);

	dialog.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", () => dialog.close()));
	// A click on the dimmed backdrop (the dialog itself, outside the panel) closes it
	dialog.addEventListener("click", (e) => {
		if (e.target === dialog) dialog.close();
	});

	const showError = (text: string) => {
		error.textContent = text;
		error.hidden = false;
	};

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		error.hidden = true;
		const data = new FormData(form);
		const name = String(data.get("name") ?? "").trim();
		const from = String(data.get("email") ?? "").trim();
		const message = String(data.get("message") ?? "").trim();

		if (!name || !message) return showError("Add your name and a message, then send again.");
		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(from)) return showError("That email doesn't look right. Check it and send again.");
		if (data.get("botcheck")) return;

		// No key yet: hand the message to the visitor's mail app instead
		if (!key) {
			const subject = encodeURIComponent(`Portfolio message from ${name}`);
			const body = encodeURIComponent(`${message}\n\n${name}\n${from}`);
			location.href = `mailto:${email}?subject=${subject}&body=${body}`;
			return;
		}

		send.disabled = true;
		send.textContent = "Sending…";
		try {
			const res = await fetch("https://api.web3forms.com/submit", {
				method: "POST",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify({
					access_key: key,
					subject: `Portfolio message from ${name}`,
					from_name: "rubyasanchez.github.io",
					name,
					email: from,
					message,
				}),
			});
			const json = await res.json();
			if (!json.success) throw new Error(json.message);
			form.reset();
			formState.hidden = true;
			sentState.hidden = false;
		} catch {
			showError(`That didn't send. Try again, or email me at ${email}.`);
		} finally {
			send.disabled = false;
			send.textContent = "Send message";
		}
	});
</script>

<style>
	.contact-dialog {
		width: min(34rem, calc(100% - 2rem));
		max-height: calc(100dvh - 2rem);
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-ink);
		overflow: visible;
	}

	.contact-dialog::backdrop {
		background: rgb(34 26 31 / 0.45);
		backdrop-filter: blur(4px);
	}

	/* Opens on the site's rising curved edge */
	.contact-dialog[open] .panel {
		animation: rise 0.7s var(--ease-fluid) both;
	}

	.contact-dialog[open]::backdrop {
		animation: fade 0.4s var(--ease-fluid) both;
	}

	@keyframes rise {
		from {
			clip-path: ellipse(150% 0% at 50% 100%);
			transform: translateY(1.5rem);
		}
		to {
			clip-path: ellipse(150% 150% at 50% 100%);
			transform: none;
		}
	}

	@keyframes fade {
		from {
			opacity: 0;
		}
	}

	.panel {
		position: relative;
		max-height: calc(100dvh - 2rem);
		overflow-y: auto;
		padding: var(--space-4) var(--space-3) var(--space-3);
		border-radius: 1.5rem;
		background: var(--color-bg);
		box-shadow: 0 40px 80px -30px rgb(34 26 31 / 0.6);
	}

	.close {
		position: absolute;
		top: var(--space-2);
		right: var(--space-2);
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 50%;
		background: none;
		font-size: 1.75rem;
		line-height: 1;
		color: var(--color-ink-soft);
		cursor: pointer;
		transition: background 0.3s var(--ease-fluid);
	}

	.close:hover {
		background: var(--color-bg-raised);
		color: var(--color-ink);
	}

	h2 {
		font-size: var(--text-2xl);
		line-height: 1.1;
	}

	.intro {
		margin-top: var(--space-1);
		color: var(--color-ink-soft);
	}

	form {
		display: grid;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}

	.row {
		display: grid;
		gap: 0.35rem;
	}

	label {
		font-size: var(--text-label);
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--color-ink-soft);
	}

	input,
	textarea {
		width: 100%;
		padding: 0.75rem 0.9rem;
		border: 1.5px solid var(--color-line);
		border-radius: 0.75rem;
		background: #fff;
		font: inherit;
		color: var(--color-ink);
		transition: border-color 0.3s var(--ease-fluid);
	}

	textarea {
		resize: vertical;
		min-height: 8rem;
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	.trap {
		position: absolute;
		left: -9999px;
	}

	.error {
		font-size: var(--text-sm);
		color: var(--color-accent);
	}

	.send {
		justify-self: start;
		margin-top: var(--space-1);
		padding: 0.75rem 1.5rem;
		border: 0;
		border-radius: 999px;
		background: var(--color-accent);
		font: inherit;
		font-weight: 600;
		color: var(--color-accent-ink);
		cursor: pointer;
		transition: transform 0.4s var(--ease-fluid);
	}

	.send:hover {
		transform: translateY(-0.15rem);
	}

	.send:disabled {
		opacity: 0.7;
		cursor: progress;
	}

	.direct {
		margin-top: var(--space-3);
		padding-top: var(--space-2);
		border-top: 1px solid var(--color-line);
		font-size: var(--text-sm);
		color: var(--color-ink-soft);
	}

	.direct a {
		color: var(--color-accent);
		overflow-wrap: anywhere;
	}

	.state-sent .send {
		margin-top: var(--space-3);
	}
</style>
