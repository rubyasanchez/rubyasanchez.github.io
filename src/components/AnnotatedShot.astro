---
import CroppedImage from "./CroppedImage.astro";

type Note = {
	/** Pin position, as a percentage of the full source image. */
	x: number;
	y: number;
	text: string;
};

interface Props {
	src: string;
	alt: string;
	width: number;
	height: number;
	notes?: Note[];
	cropTop?: number;
	cropBottom?: number;
	cropX?: number;
}

const { src, alt, width, height, notes = [], cropTop = 0, cropBottom = 0, cropX = 0 } = Astro.props;

// Pins are placed on the full source image, so shift and scale them into the cropped frame.
const visibleY = 100 - cropTop - cropBottom;
const visibleX = 100 - 2 * cropX;
const pinStyle = (note: Note) =>
	`left: ${((note.x - cropX) / visibleX) * 100}%; top: ${((note.y - cropTop) / visibleY) * 100}%`;
---

<figure class="shot bleed">
	<CroppedImage
		class="shot-frame"
		src={src}
		alt={alt}
		width={width}
		height={height}
		cropTop={cropTop}
		cropBottom={cropBottom}
		cropX={cropX}
	>
		{
			notes.map((note, i) => (
				<span class="shot-pin" style={pinStyle(note)} aria-hidden="true">
					{i + 1}
				</span>
			))
		}
	</CroppedImage>
	{
		notes.length > 0 && (
			<ol class="shot-notes" aria-label="Annotations">
				{notes.map((note, i) => (
					<li>
						<span class="shot-num" aria-hidden="true">{i + 1}</span>
						<span>{note.text}</span>
					</li>
				))}
			</ol>
		)
	}
</figure>

<style>
	.shot {
		margin-block: var(--space-4) 0;
	}

	.shot :global(.shot-frame) {
		box-shadow: 0 1px 2px rgb(28 27 25 / 0.06), 0 12px 32px -12px rgb(28 27 25 / 0.18);
	}

	.shot-pin {
		position: absolute;
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		transform: translate(-50%, -50%);
		border-radius: 999px;
		border: 2px solid var(--color-accent-ink);
		background: var(--color-accent);
		color: var(--color-accent-ink);
		font-size: var(--text-label);
		font-weight: 600;
		box-shadow: 0 0 0 4px rgb(181 72 46 / 0.22);
	}

	.shot-notes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: var(--space-2) var(--space-3);
		margin-top: var(--space-3);
	}

	.shot-notes li {
		display: flex;
		gap: 0.75rem;
		padding-left: 0;
		font-size: var(--text-sm);
		line-height: 1.45;
		color: var(--color-ink-soft);
	}

	.shot-notes li::before {
		content: none;
	}

	.shot-num {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-accent-ink);
		font-size: var(--text-label);
		font-weight: 600;
	}

	@media (max-width: 40rem) {
		.shot-pin {
			width: 1.25rem;
			height: 1.25rem;
			font-size: var(--text-label);
			border-width: 1.5px;
			box-shadow: 0 0 0 2px rgb(181 72 46 / 0.22);
		}
	}
</style>
