---
type Option = {
	label: string;
	detail: string;
	chosen?: boolean;
};

interface Props {
	number: number;
	title: string;
	options: Option[];
}

const { number, title, options } = Astro.props;
---

<section class="case-section decision reveal">
	<p class="decision-num" aria-hidden="true">{String(number).padStart(2, "0")}</p>
	<p class="eyebrow section-eyebrow">Decision {String(number).padStart(2, "0")}</p>
	<h2>{title}</h2>
	<div class="case-copy">
		<ol class="choices" aria-label="Approaches we considered">
			{
				options.map((option) => (
					<li class:list={["choice", { "is-chosen": option.chosen }]}>
						<p class="choice-label">
							{option.label}
							{option.chosen && <span class="choice-flag">Chosen</span>}
						</p>
						<p class="choice-detail">{option.detail}</p>
					</li>
				))
			}
		</ol>
		<slot />
	</div>
</section>

<style>
	/* The band's own padding already separates it, so it needs less outside gap than a plain section. */
	.case-section.decision {
		margin-top: var(--space-4);
	}

	/* A full-bleed tinted band sets the two decisions apart from the surrounding story. */
	.decision {
		position: relative;
		padding-block: var(--space-5);
		background: var(--color-bg-raised);
		box-shadow: 0 0 0 100vmax var(--color-bg-raised);
		clip-path: inset(0 -100vmax);
	}

	.decision-num {
		position: absolute;
		top: var(--space-4);
		right: 0;
		font-family: var(--font-serif);
		font-size: clamp(4rem, 3rem + 5vw, 7rem);
		line-height: 1;
		color: var(--color-line);
		pointer-events: none;
	}

	.decision h2 {
		position: relative;
		font-size: var(--text-xl);
		max-width: 22ch;
	}

	.choices {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-3);
	}

	.choice {
		padding: var(--space-2) 0 0;
		border-top: 2px solid var(--color-line);
		opacity: 0.8;
	}

	.choice::before {
		content: none;
	}

	.choice.is-chosen {
		border-top: 3px solid var(--color-accent);
		opacity: 1;
	}

	.choice-label {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: var(--text-body);
		line-height: 1.3;
		color: var(--color-ink);
	}

	.is-chosen .choice-label {
		color: var(--color-accent);
	}

	.choice-flag {
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-accent-ink);
		font-size: var(--text-label);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.choice-detail {
		margin-top: 0.375rem;
		font-size: var(--text-sm);
		line-height: 1.45;
	}

	@media (max-width: 40rem) {
		.choices {
			grid-template-columns: 1fr;
			gap: var(--space-2);
		}
	}
</style>
