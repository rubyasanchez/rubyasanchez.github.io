---
const stripRace = [
	{ src: "/images/about/cycling-selfie.jpg", alt: "Ruby on a cycling ride" },
	{ src: "/images/about/swim-celebration.jpg", alt: "Celebrating a swim conference championship" },
	{ src: "/images/about/race-finish.jpg", alt: "Crossing the 5k finish line" },
];

const stripCrew = [
	{ src: "/images/about/cycling-road.jpg", alt: "Two cyclists on a coastal road" },
	{ src: "/images/about/friends-hoodies.jpg", alt: "Ruby and a friend in matching hoodies" },
	{ src: "/images/about/pool-deck.jpg", alt: "Resting on the pool edge between sets" },
];

const tiles = "SWIM BIKE RUN".split("");

const stickers = [
	{ type: "star", color: "#f0c9c2", top: "3%", left: "72%", rot: -14, size: "1.7rem" },
	{ type: "heart", color: "#b9d3e4", top: "15%", left: "83%", rot: 11, size: "1.5rem" },
	{ type: "star", color: "#f2dd9e", top: "1%", left: "60%", rot: 9, size: "1.3rem" },
	{ type: "heart", color: "#c7ddc3", top: "27%", left: "66%", rot: -10, size: "1.5rem" },
	{ type: "star", color: "#c9ddd0", top: "37%", left: "81%", rot: 13, size: "1.4rem" },
	{ type: "heart", color: "#ddc6e0", top: "50%", left: "53%", rot: -9, size: "1.4rem" },
	{ type: "star", color: "#f0c9c2", top: "55%", left: "75%", rot: 8, size: "1.6rem" },
	{ type: "heart", color: "#b9d3e4", top: "68%", left: "60%", rot: -12, size: "1.3rem" },
	{ type: "star", color: "#f2dd9e", top: "80%", left: "79%", rot: 15, size: "1.5rem" },
	{ type: "heart", color: "#c7ddc3", top: "90%", left: "42%", rot: 9, size: "1.3rem" },
	{ type: "star", color: "#c9ddd0", top: "44%", left: "5%", rot: -11, size: "1.3rem" },
	{ type: "heart", color: "#ddc6e0", top: "1%", left: "27%", rot: 12, size: "1.2rem" },
	{ type: "heart", color: "#f0c9c2", top: "70%", left: "88%", rot: -10, size: "1.4rem" },
	{ type: "star", color: "#b9d3e4", top: "88%", left: "68%", rot: 14, size: "1.5rem" },
	{ type: "star", color: "#ddc6e0", top: "60%", left: "42%", rot: -9, size: "1.2rem" },
];
---

<div class="board-wrap reveal">
	<div class="board-frame">
		<div class="lace-mat">
			<div class="board-fabric">
				<div class="board-item pennant" style="--top:2%; --left:2%; --rot:-11deg;">
					<div class="pennant-flag">UCSC</div>
					<div class="pennant-pole" />
				</div>

				<div class="board-item strip" style="--top:7%; --left:13%; --rot:-7deg;">
					<div class="strip-frame">
						{stripRace.map((p) => <img src={p.src} alt={p.alt} loading="lazy" />)}
					</div>
					<span class="strip-label">race season</span>
				</div>

				<div class="board-item strip" style="--top:9%; --left:32%; --rot:8deg;">
					<div class="strip-frame">
						{stripCrew.map((p) => <img src={p.src} alt={p.alt} loading="lazy" />)}
					</div>
					<span class="strip-label">the crew</span>
				</div>

				<div class="board-item craft craft-natalie" style="--top:3%; --left:45%; --rot:-9deg;">
					<img src="/images/about/crafts/pennant-natalie.png" alt="A handmade felt pennant reading Natalie, made by Ruby" loading="lazy" />
				</div>

				<div class="board-item craft craft-abby" style="--top:33%; --left:7%; --rot:10deg;">
					<img src="/images/about/crafts/pennant-abby.png" alt="A handmade felt pennant, made by Ruby" loading="lazy" />
				</div>

				<div class="board-item tiles" style="--top:47%; --left:19%; --rot:-4deg;" aria-label="Swim. Bike. Run.">
					<div class="tile-row">
						{tiles.map((ch) =>
							ch === " " ? <span class="tile-gap" /> : <span class="tile">{ch}</span>
						)}
					</div>
				</div>

				<div class="board-item compass-sticker" style="--top:29%; --left:56%; --rot:13deg;" aria-hidden="true">
					<svg viewBox="0 0 48 48" width="44" height="44">
						<circle cx="24" cy="24" r="21" fill="none" stroke="#b5482e" stroke-width="2.5" />
						<path d="M31 17l-5 10-10 5 5-10 10-5Z" fill="#b5482e" />
						<circle cx="24" cy="24" r="2.5" fill="#faf7f2" stroke="#b5482e" stroke-width="1.5" />
					</svg>
				</div>

				<div class="board-item note" style="--top:60%; --left:5%; --rot:6deg;">
					<p>
						Obsessed with what Strava, Garmin &amp; Oura get right (and wrong) about turning
						data into motivation. Want to design in this space next.
					</p>
				</div>

				<div class="board-item bib" style="--top:57%; --left:33%; --rot:-8deg;">
					<span class="bib-number">4240</span>
					<span class="bib-label">She Is Beautiful 5K</span>
				</div>

				<div class="board-item craft craft-crown" style="--top:78%; --left:26%; --rot:7deg;">
					<img src="/images/about/crafts/crown-22.png" alt="A handmade felt birthday crown Ruby sewed for a friend's 22nd birthday" loading="lazy" />
				</div>

				{
					stickers.map((s) =>
						s.type === "star" ? (
							<div
								class="board-item sticker star"
								style={`--top:${s.top}; --left:${s.left}; --rot:${s.rot}deg; --sticker-color:${s.color}; --sticker-size:${s.size};`}
								aria-hidden="true"
							/>
						) : (
							<div
								class="board-item sticker heart"
								style={`--top:${s.top}; --left:${s.left}; --rot:${s.rot}deg; --sticker-color:${s.color}; --sticker-size:${s.size};`}
								aria-hidden="true"
							>
								<svg viewBox="0 0 24 24" width="100%" height="100%">
									<path
										d="M12 21s-6.5-4.35-9.5-8.5C.5 9.5 1.5 5.5 5 4.5c2-.6 4 .3 5 2 1-1.7 3-2.6 5-2 3.5 1 4.5 5 2.5 8-3 4.15-9.5 8.5-9.5 8.5z"
										fill={s.color}
									/>
								</svg>
							</div>
						)
					)
				}
			</div>
		</div>
	</div>
</div>

<style>
	.board-wrap {
		margin-top: var(--space-4);
	}

	.board-frame {
		background: linear-gradient(160deg, #8a6a4a, #63472f);
		padding: 1.25rem;
		border-radius: 10px;
		box-shadow: 0 40px 70px -30px rgba(28, 27, 25, 0.4), 0 14px 24px -12px rgba(28, 27, 25, 0.25);
	}

	.lace-mat {
		padding: 0.85rem;
		border-radius: 6px;
		background-color: #fdfaf5;
		background-image: radial-gradient(circle, rgba(139, 105, 75, 0.28) 1px, transparent 1.4px);
		background-size: 9px 9px;
	}

	.board-fabric {
		position: relative;
		min-height: 51rem;
		border-radius: 3px;
		background-color: #f4ece0;
		background-image: repeating-linear-gradient(
				90deg,
				rgba(181, 72, 46, 0.14),
				rgba(181, 72, 46, 0.14) 2px,
				transparent 2px,
				transparent 22px
			),
			repeating-linear-gradient(
				0deg,
				rgba(181, 72, 46, 0.14),
				rgba(181, 72, 46, 0.14) 2px,
				transparent 2px,
				transparent 22px
			);
		background-blend-mode: multiply;
		border: 8px solid #fdfaf5;
		box-shadow: inset 0 0 0 1px rgba(28, 27, 25, 0.08);
		overflow: hidden;
	}

	.board-item {
		position: absolute;
		top: var(--top);
		left: var(--left);
		transform: rotate(var(--rot));
		transition: transform 0.25s ease;
	}

	.board-item:hover {
		transform: rotate(var(--rot)) translateY(-3px) scale(1.04);
		z-index: 30 !important;
	}

	/* Pennant */
	.pennant {
		z-index: 4;
		display: flex;
		align-items: center;
	}

	.pennant-flag {
		width: 6.5rem;
		height: 3.5rem;
		clip-path: polygon(0 0, 100% 50%, 0 100%);
		background: var(--color-accent);
		color: #fdf5f0;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.9375rem;
		letter-spacing: 0.03em;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-right: 1.25rem;
		box-shadow: 0 8px 16px -8px rgba(28, 27, 25, 0.4);
	}

	.pennant-pole {
		width: 3px;
		height: 4.5rem;
		background: #6b4e36;
		margin-left: -1px;
	}

	/* Pastel stickers */
	.sticker {
		z-index: 6;
		width: var(--sticker-size);
		height: var(--sticker-size);
		filter: drop-shadow(0 5px 7px rgba(28, 27, 25, 0.28));
	}

	.sticker.star {
		background: var(--sticker-color);
		clip-path: polygon(
			50% 0%,
			61% 35%,
			98% 35%,
			68% 57%,
			79% 91%,
			50% 70%,
			21% 91%,
			32% 57%,
			2% 35%,
			39% 35%
		);
	}

	/* Film strips */
	.strip {
		z-index: 3;
	}

	.strip-frame {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		background: #fff;
		padding: 0.5rem 0.5rem 0.75rem;
		box-shadow: 0 16px 26px -12px rgba(28, 27, 25, 0.4);
	}

	.strip-frame img {
		width: 6.5rem;
		height: 5rem;
		object-fit: cover;
		display: block;
	}

	.strip-label {
		display: block;
		margin-top: 0.35rem;
		text-align: center;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.8125rem;
		color: var(--color-ink-soft);
	}

	/* Scrabble tiles */
	.tiles {
		z-index: 5;
	}

	.tile-row {
		display: flex;
		gap: 0.3rem;
	}

	.tile,
	.tile-gap {
		width: 1.75rem;
		height: 1.75rem;
	}

	.tile-gap {
		width: 0.75rem;
	}

	.tile {
		background: #fdfaf5;
		border: 1px solid var(--color-line);
		border-radius: 2px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.9375rem;
		color: var(--color-ink);
		box-shadow: 0 4px 8px -4px rgba(28, 27, 25, 0.35);
	}

	/* Handwritten note */
	.note {
		z-index: 4;
		width: 12rem;
		padding: 0.75rem 0.875rem;
		background: #fffdf7;
		background-image: repeating-linear-gradient(
			transparent,
			transparent 1.35rem,
			rgba(28, 27, 25, 0.08) 1.35rem,
			rgba(28, 27, 25, 0.08) calc(1.35rem + 1px)
		);
		box-shadow: 0 14px 24px -12px rgba(28, 27, 25, 0.3);
	}

	.note p {
		font-family: "Caveat", var(--font-serif);
		font-size: 1.25rem;
		line-height: 1.35rem;
		color: #3a332c;
	}

	/* Race bib */
	.bib {
		z-index: 5;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 8rem;
		padding: 0.625rem 0.5rem;
		background: #fffdf9;
		border: 1px dashed var(--color-ink-faint);
		box-shadow: 0 10px 20px -10px rgba(28, 27, 25, 0.3);
	}

	.bib-number {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 1.375rem;
		color: var(--color-accent);
	}

	.bib-label {
		margin-top: 0.125rem;
		font-size: 0.6875rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		text-align: center;
	}

	.compass-sticker {
		z-index: 4;
		filter: drop-shadow(0 6px 10px rgba(28, 27, 25, 0.25));
	}

	/* Handmade felt crafts */
	.craft {
		z-index: 5;
		filter: drop-shadow(0 10px 14px rgba(28, 27, 25, 0.3));
	}

	.craft img {
		display: block;
	}

	.craft-natalie img {
		width: 9rem;
		height: auto;
	}

	.craft-abby img {
		width: 4.5rem;
		height: auto;
	}

	.craft-crown img {
		width: 11rem;
		height: auto;
	}

	@media (max-width: 760px) {
		.board-fabric {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1.75rem;
			padding: 2rem 1.25rem;
			min-height: auto;
		}

		.board-item {
			position: static;
			top: auto;
			left: auto;
			transform: rotate(var(--rot));
		}

		.board-item:hover {
			transform: rotate(var(--rot)) scale(1.03);
		}

		.pennant {
			align-self: flex-start;
		}

		.sticker {
			display: none;
		}
	}
</style>
