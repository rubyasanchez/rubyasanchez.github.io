---
type Job = {
	who: string;
	when: string;
	want: string;
	so: string;
};

interface Props {
	jobs: Job[];
}

const { jobs } = Astro.props;
---

<div class="jobs">
	{
		jobs.map((job) => (
			<div class="job">
				<p class="job-who">{job.who}</p>
				<dl class="job-story">
					<div>
						<dt>When</dt>
						<dd>{job.when}</dd>
					</div>
					<div>
						<dt>I want to</dt>
						<dd>{job.want}</dd>
					</div>
					<div>
						<dt>So I can</dt>
						<dd>{job.so}</dd>
					</div>
				</dl>
			</div>
		))
	}
</div>

<style>
	.jobs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-2);
		margin: var(--space-3) 0;
	}

	.job {
		padding: var(--space-2) var(--space-3) var(--space-3);
		background: var(--color-bg-raised);
		border-top: 3px solid var(--color-accent);
		border-radius: 2px;
	}

	.job-who {
		font-size: var(--text-label);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.job-story {
		display: grid;
		gap: var(--space-1);
		margin: var(--space-2) 0 0;
	}

	.job-story dt {
		font-size: var(--text-label);
		font-weight: 600;
		color: var(--color-ink);
	}

	.job-story dd {
		margin: 0;
		font-family: var(--font-serif);
		font-size: var(--text-body);
		line-height: 1.4;
		color: var(--color-ink);
	}
</style>
