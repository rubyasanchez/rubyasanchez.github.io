---
import type { Project } from "../data/projects";

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<a class="project-card" href={`/work/${project.slug}`}>
	<p class="project-card-tags">{project.tags.join(" · ")}</p>
	<h3 class="project-card-title">
		{project.title} <span class="project-card-subtitle">| {project.subtitle}</span>
	</h3>
	<p class="project-card-summary">{project.summary}</p>
	<p class="project-card-impact placeholder">{project.impact}</p>
	<span class="project-card-cta">View case study &rarr;</span>
</a>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-3);
		background: var(--color-bg-raised);
		border: 1px solid var(--color-line);
		border-radius: 2px;
		text-decoration: none;
		color: var(--color-ink);
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.project-card:hover {
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}

	.project-card-tags {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
	}

	.project-card-title {
		font-size: 1.375rem;
		margin-top: var(--space-1);
	}

	.project-card-subtitle {
		font-weight: 400;
		color: var(--color-ink-soft);
	}

	.project-card-summary {
		color: var(--color-ink-soft);
		margin-top: var(--space-1);
	}

	.project-card-impact {
		font-size: 0.9375rem;
		margin-top: var(--space-1);
	}

	.project-card-cta {
		margin-top: var(--space-2);
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--color-accent);
	}
</style>
