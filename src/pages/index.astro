---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaveEntrance from "../components/WaveEntrance.astro";
import RollingWord from "../components/RollingWord.astro";
import BeforeAfterToggle from "../components/BeforeAfterToggle.astro";
import ContactDialog from "../components/ContactDialog.astro";

// Work roles alternate with a bit of personality from the About page
const roles = [
	"a product thinker",
	"a sunset chaser",
	"a UX researcher",
	"a former swim captain",
	"a product designer",
	"a home baker",
];

const compassImg = (name: string) => `/images/case-studies/compass/${name}`;
const datashareImg = (name: string) => `/images/case-studies/datashare/${name}`;
---

<BaseLayout title="Product Design & UX Research">
	<WaveEntrance slot="top" />

	<section class="hero">
		<div class="container">
			<h1 class="hero-title">
				<span aria-hidden="true">I’m Ruby, <RollingWord words={roles} /></span>
				<span class="sr-only">
					I’m Ruby: a product thinker, UX researcher, and product designer. Also a sunset chaser,
					former swim captain, and home baker.
				</span>
			</h1>
			<p class="hero-lede">
				I turn research into product decisions, and product decisions into thoughtful experiences.
			</p>
			<a class="hero-cue" href="#work">Selected work <span aria-hidden="true">↓</span></a>
		</div>
	</section>

	<div id="work" class="featured">
		<article class="feature feature-compass" data-open>
			<div class="container feature-inner">
				<div class="feature-text">
					<p class="feature-meta"><span>Product Design</span> · <span>AI Interaction Design</span> · <span>Design Leadership</span> · <span>2025</span></p>
					<h2 class="feature-title">Compass</h2>
					<p class="feature-premise">Making mentorship scale without making it feel automated.</p>
					<a class="cta" href="/work/compass">View case study <span aria-hidden="true">↗</span></a>
				</div>
				<div class="fluid" data-fluid>
					<a class="layered" href="/work/compass" data-cursor tabindex="-1" aria-hidden="true">
						<span class="shot shot-desk">
							<img
								src={compassImg("home-queue.jpg")}
								alt=""
								width="1440"
								height="1000"
								loading="lazy"
							/>
						</span>
						<span class="shot shot-phone">
							<img src={compassImg("home-phone.jpg")} alt="" width="390" height="876" loading="lazy" />
						</span>
					</a>
				</div>
			</div>
		</article>

		<article class="feature feature-datashare" data-open>
			<div class="container feature-inner">
				<div class="feature-text">
					<p class="feature-meta"><span>UX Research</span> · <span>Information Architecture</span> · <span>Usability Testing</span> · <span>2025</span></p>
					<h2 class="feature-title">DataShare Santa Cruz County</h2>
					<p class="feature-premise">
						Making the county's public health data easier to find, understand, and act on.
					</p>
					<a class="cta" href="/work/datashare">View case study <span aria-hidden="true">↗</span></a>
				</div>
				<div class="fluid" data-fluid>
					<div>
						<BeforeAfterToggle
							before={{
								src: datashareImg("home-before.jpg"),
								alt: "Original DataShare homepage: a photo collage and announcement banner, then an intro paragraph with a small search field",
								width: 1512,
								height: 1100,
								label: "Original",
							}}
							after={{
								src: datashareImg("home-after.jpg"),
								alt: "Redesigned DataShare homepage: a search-first header with three shortcuts, then a featured data story",
								width: 1514,
								height: 1100,
								label: "Redesign",
							}}
						/>
					</div>
				</div>
			</div>
		</article>
	</div>

	<section class="contact" aria-labelledby="contact-title">
		<div class="container">
			<h2 id="contact-title" class="contact-title">Let’s talk.</h2>
			<p class="contact-lede">
				Have a question about my work, or want to work together? My inbox is open.
			</p>
			<ul class="contact-cards">
				<li class="card card-email">
					<p class="card-label">Email</p>
					<a class="card-value card-link" href="mailto:rualsanc@berkeley.edu" data-contact-open>rualsanc@berkeley.edu</a>
					<button type="button" class="copy" data-copy="rualsanc@berkeley.edu">Copy</button>
				</li>
				<li class="card card-linkedin">
					<p class="card-label">LinkedIn</p>
					<a
						class="card-value card-link"
						href="https://www.linkedin.com/in/rubyasanchez03/"
						target="_blank"
						rel="noopener">Let’s connect</a
					>
					<span class="card-arrow" aria-hidden="true">↗</span>
				</li>
				<li class="card card-resume">
					<p class="card-label">Resume</p>
					<a class="card-value card-link" href="/resume">UX and PM versions</a>
					<span class="card-arrow" aria-hidden="true">→</span>
				</li>
			</ul>
		</div>
	</section>

	<ContactDialog />

	<div class="view-cursor" aria-hidden="true">View case study ↗</div>
</BaseLayout>

<script>
	// Feature panels start inset with soft corners and open to full width as they arrive
	const panels = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add("is-open");
					panels.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0.2 },
	);
	document.querySelectorAll("[data-open]").forEach((el) => panels.observe(el));

	// Project visuals surface through a rising curved edge. The wrapper is observed, not the
	// clipped visual, because a fully clipped element never registers as on screen.
	const fluid = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add("is-visible");
					fluid.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0.15 },
	);
	document.querySelectorAll("[data-fluid]").forEach((el) => fluid.observe(el));

	// Copy the email address, with a short confirmation on the button
	document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy!);
				button.textContent = "Copied";
			} catch {
				button.textContent = "Press ⌘C";
				getSelection()?.selectAllChildren(button.previousElementSibling!);
			}
			setTimeout(() => (button.textContent = "Copy"), 1800);
		});
	});

	// Contextual "View case study" label that trails the cursor, mouse only
	const cursor = document.querySelector<HTMLElement>(".view-cursor");
	if (cursor && matchMedia("(hover: hover) and (pointer: fine)").matches) {
		let x = 0;
		let y = 0;
		let cx = 0;
		let cy = 0;
		let frame = 0;
		const follow = () => {
			cx += (x - cx) * 0.2;
			cy += (y - cy) * 0.2;
			cursor.style.transform = `translate(${cx}px, ${cy}px)`;
			frame = Math.abs(x - cx) + Math.abs(y - cy) > 0.3 ? requestAnimationFrame(follow) : 0;
		};
		document.querySelectorAll<HTMLElement>("[data-cursor]").forEach((el) => {
			el.addEventListener("pointerenter", (e) => {
				cx = x = e.clientX;
				cy = y = e.clientY;
				follow();
				cursor.classList.add("is-on");
			});
			el.addEventListener("pointermove", (e) => {
				x = e.clientX;
				y = e.clientY;
				if (!frame) frame = requestAnimationFrame(follow);
			});
			el.addEventListener("pointerleave", () => cursor.classList.remove("is-on"));
		});
	}
</script>

<style>
	/* ---------- Hero: calm and type-led ---------- */
	.hero {
		padding-block: clamp(4rem, 12vh, 8rem) var(--space-5);
	}

	.hero-title {
		max-width: 16em;
		font-size: clamp(2.5rem, 1.5rem + 4.4vw, 5rem);
		font-weight: 500;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	.hero-title :global(.roll) {
		font-style: italic;
		font-weight: 400;
		color: var(--color-accent);
	}

	.hero-lede {
		max-width: 34rem;
		margin-top: var(--space-3);
		font-family: var(--font-serif);
		font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
		line-height: 1.4;
		color: var(--color-ink-soft);
	}

	.hero-cue {
		display: inline-flex;
		gap: 0.4rem;
		margin-top: var(--space-5);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-ink);
		text-decoration: none;
	}

	.hero-cue span {
		color: var(--color-accent);
		transition: transform 0.45s var(--ease-fluid);
	}

	.hero-cue:hover span {
		transform: translateY(0.2rem);
	}

	/* ---------- Featured projects ---------- */
	.featured {
		scroll-margin-top: 4rem;
	}

	.feature {
		margin-inline: var(--space-2);
		border-radius: 2rem 2rem 0 0;
		padding-block: var(--space-5);
		color: var(--color-ink);
		transition:
			margin 0.9s var(--ease-fluid),
			border-radius 0.9s var(--ease-fluid);
	}

	.feature.is-open {
		margin-inline: 0;
		border-radius: 0;
	}

	.feature-compass {
		background: var(--color-sky);
	}

	.feature-datashare {
		background: var(--color-butter);
	}

	.feature-inner {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: var(--space-5);
		align-items: center;
	}

	.feature-text {
		display: grid;
		justify-items: start;
		gap: var(--space-2);
	}

	/* If the label has to wrap, it breaks between items, never inside one */
	.feature-meta span {
		white-space: nowrap;
	}

	.feature-meta {
		font-size: var(--text-label);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-soft);
	}

	.feature-title {
		font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
		line-height: 1.05;
		text-wrap: balance;
	}

	.feature-premise {
		max-width: 26rem;
		font-size: var(--text-lg);
		line-height: 1.45;
		color: var(--color-ink-soft);
	}

	/* The fill floods in from the left on hover, on the same curve as every other reveal */
	.cta {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		margin-top: var(--space-1);
		display: inline-flex;
		gap: 0.4rem;
		padding: 0.65rem 1.25rem;
		border: 1.5px solid var(--color-ink);
		border-radius: 999px;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-ink);
		text-decoration: none;
		transition:
			color 0.4s var(--ease-fluid),
			border-color 0.4s var(--ease-fluid);
	}

	.cta::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--color-accent);
		clip-path: inset(0 100% 0 0 round 999px);
		transition: clip-path 0.55s var(--ease-fluid);
	}

	.cta:hover,
	.cta:focus-visible {
		color: var(--color-accent-ink);
		border-color: var(--color-accent);
	}

	.cta:hover::before,
	.cta:focus-visible::before {
		clip-path: inset(0 0 0 0 round 999px);
	}

	/* ---------- Compass: mentor queue with the student's phone in front ---------- */
	.layered {
		position: relative;
		display: block;
		aspect-ratio: 100 / 66;
	}

	.shot {
		position: absolute;
		overflow: hidden;
		box-shadow:
			0 1px 2px rgb(34 26 31 / 0.12),
			0 28px 56px -28px rgb(34 26 31 / 0.55);
		transition: transform 0.8s var(--ease-fluid);
	}

	.shot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.shot-desk {
		left: 0;
		top: 0;
		width: 84%;
		aspect-ratio: 1440 / 1000;
		border-radius: 0.75rem;
	}

	.shot-phone {
		right: 2%;
		top: 14%;
		width: 25%;
		aspect-ratio: 390 / 876;
		border-radius: 10% / 4.6%;
	}

	.layered:hover .shot-desk {
		transform: translate(-0.4rem, -0.3rem);
	}

	.layered:hover .shot-phone {
		transform: translate(0.4rem, -1rem);
	}

	/* Project visuals surface through a rising curved edge instead of fading in */
	:global(html.js) .fluid > * {
		clip-path: ellipse(150% 0% at 50% 100%);
		transition: clip-path 1.1s var(--ease-fluid);
	}

	:global(html.js) .fluid.is-visible > * {
		clip-path: ellipse(150% 150% at 50% 100%);
	}

	/* ---------- Contact: back on cream, type-led like the hero ---------- */
	.contact {
		padding-block: var(--space-6);
	}

	.contact-title {
		font-size: clamp(2.5rem, 1.5rem + 4.4vw, 5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.contact-lede {
		max-width: 30rem;
		margin-top: var(--space-2);
		font-family: var(--font-serif);
		font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
		line-height: 1.4;
		color: var(--color-ink-soft);
	}

	/* Three cards, each in one of the palette's fields */
	.contact-cards {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.card {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		align-content: space-between;
		gap: var(--space-4);
		min-height: 11rem;
		padding: var(--space-3);
		border-radius: 1.25rem;
		color: var(--color-ink);
		transition:
			transform 0.6s var(--ease-fluid),
			box-shadow 0.6s var(--ease-fluid);
	}

	/* Lift on hover, or on keyboard focus only: a mouse click (LinkedIn opens a new tab) leaves
	   focus behind, and :focus-within would keep that card raised so hover seemed to do nothing */
	.card:hover,
	.card:has(:focus-visible) {
		transform: translateY(-0.35rem);
		box-shadow: 0 24px 40px -24px rgb(34 26 31 / 0.45);
	}

	.card-email {
		background: var(--color-accent);
		color: var(--color-accent-ink);
	}

	.card-linkedin {
		background: var(--color-sky);
	}

	.card-resume {
		background: var(--color-butter);
	}

	.card-label {
		font-size: var(--text-label);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.8;
	}

	.card-value {
		align-self: end;
		font-family: var(--font-serif);
		font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
		line-height: 1.2;
		color: inherit;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.card-email .card-value {
		font-style: italic;
	}

	/* Each whole card is clickable through its link; the email card's Copy button sits above it */
	.card-link::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.card-link:focus-visible {
		outline: none;
	}

	.card:has(.card-link:focus-visible) {
		outline: 2px solid var(--color-ink);
		outline-offset: 3px;
	}

	.card-arrow {
		position: absolute;
		top: var(--space-3);
		right: var(--space-3);
		font-size: 1.25rem;
		transition: transform 0.45s var(--ease-fluid);
	}

	.card:hover .card-arrow {
		transform: translate(0.2rem, -0.2rem);
	}

	.card-resume:hover .card-arrow {
		transform: translateX(0.3rem);
	}

	.copy {
		position: absolute;
		z-index: 1;
		top: calc(var(--space-3) - 0.35rem);
		right: var(--space-3);
		padding: 0.35rem 0.85rem;
		border: 1.5px solid rgb(255 248 241 / 0.5);
		border-radius: 999px;
		background: none;
		font: inherit;
		font-size: var(--text-label);
		font-weight: 600;
		color: var(--color-accent-ink);
		cursor: pointer;
		transition:
			background 0.3s var(--ease-fluid),
			color 0.3s var(--ease-fluid);
	}

	.copy:hover {
		background: var(--color-accent-ink);
		color: var(--color-accent);
	}

	/* ---------- Contextual cursor ---------- */
	.view-cursor {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 60;
		margin: 1.25rem 0 0 -4.5rem;
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-accent-ink);
		font-size: var(--text-label);
		font-weight: 600;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.25s var(--ease-fluid);
	}

	.view-cursor.is-on {
		opacity: 1;
	}

	/* ---------- Tablet and down ---------- */
	@media (max-width: 56rem) {
		.feature-inner {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}

		.feature {
			margin-inline: var(--space-1);
			border-radius: 1.25rem 1.25rem 0 0;
			padding-block: var(--space-4);
		}
	}

	@media (max-width: 56rem) {
		.contact-cards {
			grid-template-columns: 1fr;
		}

		.card {
			min-height: 0;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-block: var(--space-4);
		}

		.hero-cue {
			margin-top: var(--space-4);
		}
	}
</style>
