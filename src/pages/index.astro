---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const heroHeadline =
	"I turn research into product decisions, and product decisions into thoughtful experiences.";
const heroHeadlineHtml = heroHeadline
	.split(" ")
	.map((word, i) => `<span class="reveal-word" style="--i:${i}">${word}</span>`)
	.join(" ");
---

<BaseLayout title="Product Design & UX Research">
	<section class="hero section">
		<div class="container hero-grid">
			<div class="hero-text">
				<p class="eyebrow hero-eyebrow"><span>Product Design</span> · <span>UX Research</span> · <span>Product Thinking</span></p>
				<h1 class="hero-headline" set:html={heroHeadlineHtml} />
				<p class="hero-sub reveal" style="--i:0">
					I work across design, research, and product to understand what people need, decide
					what matters, and turn those insights into experiences that work.
				</p>
			</div>
			<div class="hero-photo-wrap">
				<div class="hero-photo">
					<img src="/images/headshot.jpg" alt="Portrait of Ruby Sanchez" width="600" height="600" />
				</div>
				<span class="photo-bubble" aria-hidden="true">Hi, I'm Ruby 👋</span>
			</div>
			<p class="hero-meta reveal" style="--i:1">
				Master of Information Management and Systems, UC Berkeley (Expected 2028)
				&middot; B.S. Cognitive Science: AI/HCI, UC Santa Cruz (2026)
			</p>
		</div>
	</section>

	<section class="section work-section">
		<div class="container">
			<div class="section-heading reveal">
				<h2>Featured Work</h2>
				<a class="text-link" href="/work">View all case studies &rarr;</a>
			</div>
			<div class="project-grid">
				{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* Text on the left, portrait on the right; the text column takes the room, so the
	   headline runs 3–4 lines instead of wrapping into a narrow column. */
	.hero {
		padding-top: var(--space-5);
		padding-bottom: var(--space-4);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		column-gap: var(--space-5);
	}

	.hero-text {
		max-width: 42rem;
	}

	/* Keep each phrase whole when the label wraps on narrow screens. */
	.hero-eyebrow span {
		white-space: nowrap;
	}

	.hero h1 {
		margin-top: var(--space-2);
		font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem);
		line-height: 1.15;
		text-wrap: pretty;
	}

	.work-section {
		padding-top: var(--space-4);
		padding-bottom: var(--space-6);
	}

	.hero-photo-wrap {
		position: relative;
		flex: 0 0 auto;
	}

	.hero-photo {
		width: clamp(15rem, 22vw, 20rem);
		height: clamp(15rem, 22vw, 20rem);
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--color-line);
	}

	.hero-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-photo-wrap:hover .hero-photo img {
		transform: scale(1.08);
	}

	.photo-bubble {
		position: absolute;
		top: -0.75rem;
		right: 2.5rem;
		transform: translateY(-100%) scale(0.85);
		transform-origin: bottom right;
		background: var(--color-accent);
		color: var(--color-accent-ink);
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		font-weight: 500;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 3;
	}

	.photo-bubble::after {
		content: "";
		position: absolute;
		bottom: -0.25rem;
		right: 1.75rem;
		width: 0.65rem;
		height: 0.65rem;
		background: var(--color-accent);
		transform: rotate(45deg);
		border-radius: 2px;
	}

	.hero-photo-wrap:hover .photo-bubble {
		opacity: 1;
		transform: translateY(-100%) scale(1);
	}

	.hero-sub {
		max-width: 36rem;
		margin-top: var(--space-3);
		font-size: var(--text-lg);
		line-height: 1.5;
		color: var(--color-ink-soft);
	}

	.hero-meta {
		grid-column: 1 / -1;
		margin-top: var(--space-4);
		padding-top: var(--space-2);
		border-top: 1px solid var(--color-line);
		font-size: var(--text-label);
		color: var(--color-ink-faint);
	}

	/* Tablet and down: stack intentionally, portrait first as a smaller avatar. */
	@media (max-width: 56rem) {
		.hero-grid {
			grid-template-columns: 1fr;
		}

		.hero-photo-wrap {
			order: -1;
			margin-bottom: var(--space-3);
		}

		.hero-photo {
			width: 9rem;
			height: 9rem;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: var(--space-4);
		}

		.work-section {
			padding-bottom: var(--space-5);
		}
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: var(--space-4) var(--space-3);
	}
</style>
