---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="UX Research & Product Management">
	<section class="hero section">
		<div class="container">
			<div class="prose">
				<p class="eyebrow">UX Research &amp; Product Management</p>
				<h1>
					I work across UX research, design, and product management &mdash;
					focused on how design decisions shape access, understanding, and
					trust in complex information systems.
				</h1>
				<p class="hero-sub">
					My work sits at the intersection of public health, education, and
					social computing, where the systems people rely on are often the
					hardest to navigate and the easiest to lose trust in.
				</p>
				<p class="hero-meta">
					Incoming M.S. Information Management &amp; Systems, UC Berkeley (Fall 2026)
					&middot; B.S. Cognitive Science: AI/HCI, UC Santa Cruz (2026)
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading">
				<h2>Featured Work</h2>
				<a class="text-link" href="/work">View all case studies &rarr;</a>
			</div>
			<div class="project-grid">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero h1 {
		font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
		line-height: 1.25;
		margin-top: var(--space-2);
	}

	.hero-sub {
		font-size: 1.125rem;
		color: var(--color-ink-soft);
		margin-top: var(--space-3);
		max-width: 40rem;
	}

	.hero-meta {
		font-size: 0.9375rem;
		color: var(--color-ink-faint);
		margin-top: var(--space-3);
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-line);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: var(--space-3);
	}
</style>
