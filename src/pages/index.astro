---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const heroHeadline =
	"I work across UX research, design, and product management — focused on how design decisions shape access, understanding, and trust in complex information systems.";
const heroHeadlineHtml = heroHeadline
	.split(" ")
	.map((word, i) => `<span class="reveal-word" style="--i:${i}">${word}</span>`)
	.join(" ");
---

<BaseLayout title="UX Design & Product Management">
	<section class="hero section hero-spacing">
		<div class="container">
			<p class="eyebrow">UX Design &amp; Product Management</p>
			<div class="hero-heading-row">
				<h1 class="hero-headline" set:html={heroHeadlineHtml} />
				<div class="hero-photo-wrap">
					<div class="hero-photo">
						<img src="/images/headshot.jpg" alt="Portrait of Ruby Sanchez" width="600" height="600" />
					</div>
					<span class="photo-bubble" aria-hidden="true">Hi, I'm Ruby 👋</span>
				</div>
			</div>
			<p class="hero-sub reveal" style="--i:0">
				My work sits at the intersection of public health, education, and
				social computing, where the systems people rely on are often the
				hardest to navigate and the easiest to lose trust in.
			</p>
			<p class="hero-meta reveal" style="--i:1">
				M.S. Information Management &amp; Systems, UC Berkeley (Expected 2028)
				&middot; B.S. Cognitive Science: AI/HCI, UC Santa Cruz (2026)
			</p>
		</div>
	</section>

	<section class="section featured-work-spacing">
		<div class="container">
			<div class="section-heading reveal">
				<h2>Featured Work</h2>
				<a class="text-link" href="/work">View all case studies &rarr;</a>
			</div>
			<div class="project-grid">
				{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero-spacing {
		padding-top: var(--space-5);
		padding-bottom: var(--space-5);
	}

	.featured-work-spacing {
		padding-top: var(--space-6);
		padding-bottom: var(--space-6);
	}

	.hero-heading-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-2);
	}

	.hero-heading-row h1 {
		flex: 0 1 34rem;
		margin-top: 0;
	}

	.hero h1 {
		font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
		line-height: 1.25;
	}

	.hero-photo-wrap {
		position: relative;
		flex: 0 0 auto;
	}

	.hero-photo {
		width: 23rem;
		height: 23rem;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--color-line);
	}

	.hero-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-photo-wrap:hover .hero-photo img {
		transform: scale(1.08);
	}

	.photo-bubble {
		position: absolute;
		top: -0.75rem;
		right: 2.5rem;
		transform: translateY(-100%) scale(0.85);
		transform-origin: bottom right;
		background: var(--color-accent);
		color: var(--color-accent-ink);
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		font-weight: 500;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 3;
	}

	.photo-bubble::after {
		content: "";
		position: absolute;
		bottom: -0.25rem;
		right: 1.75rem;
		width: 0.65rem;
		height: 0.65rem;
		background: var(--color-accent);
		transform: rotate(45deg);
		border-radius: 2px;
	}

	.hero-photo-wrap:hover .photo-bubble {
		opacity: 1;
		transform: translateY(-100%) scale(1);
	}

	.hero-sub {
		font-size: 1.125rem;
		color: var(--color-ink-soft);
		margin-top: var(--space-3);
		max-width: 40rem;
	}

	.hero-meta {
		font-size: 0.9375rem;
		color: var(--color-ink-faint);
		margin-top: var(--space-3);
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-line);
	}

	@media (max-width: 720px) {
		.hero-heading-row {
			flex-direction: column-reverse;
			align-items: flex-start;
		}

		.hero-photo {
			width: 9rem;
			height: 9rem;
		}
	}

	@media (max-width: 640px) {
		.hero-spacing {
			padding-top: var(--space-4);
			padding-bottom: var(--space-4);
		}

		.featured-work-spacing {
			padding-top: var(--space-5);
			padding-bottom: var(--space-5);
		}
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: var(--space-4) var(--space-3);
	}
</style>
